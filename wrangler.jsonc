{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitwise",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // node:crypto (for checking old scrypt password hashes) and node:buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls run the Worker; pages, CSS and JS are served straight from Cloudflare's cache.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitwise",
      "database_id": "ee3e08d9-e6db-4cb6-85fc-6df453dd5635"
    }
  ],
  // Don't remove variables set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true }
}
